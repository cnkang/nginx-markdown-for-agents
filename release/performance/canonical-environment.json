{
  "schema_version": 1,
  "nginx_version": "1.30.4",
  "runner": "ubuntu-24.04",
  "architecture": "x86_64",
  "rust_toolchain": "1.97.0",
  "identity_contract": {
    "candidate_sha_source": "git rev-parse HEAD",
    "runner_identity_source": "uname -a and /etc/os-release captured in baseline evidence",
    "runner_image_identity_required": true,
    "nginx_source_checksum_required": true,
    "rust_toolchain_target": "x86_64-unknown-linux-gnu",
    "module_artifact_digest_required": true
  }
}
