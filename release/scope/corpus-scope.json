    {"path": "tests/corpus/**/*.md", "kind": "conversion-corpus", "categories": ["brotli"]},
    {"path": "tests/corpus/**/*.br", "kind": "conversion-corpus", "categories": ["brotli"]},
    {"path": "tools/corpus/samples/**", "kind": "large-samples", "tiers": ["large-100k", "large-5m", "large-10m", "extra-large-64m"]}
  ],
  "determinism_gate": "tools/corpus/verify_determinism.sh (tracked fixtures must be byte-identical)"
