# Example Dockerfile showing optimized installation
# This demonstrates how to use the install script efficiently in Docker builds
#
# MODULE_REF default: the tag must contain the installer bootstrap asset
# (nginx-markdown-for-agents-installer-<tag>.sh), which is published from
# >= 0.9.2 onward.  Point it at the tag under test when validating a
# candidate; a tag without that asset fails at the download step.
# INSTALL_SHA256 is required: the download is checksum-verified before the
# script is executed, and the check runs first so a missing checksum fails
# with a clear message instead of an opaque curl/404 error.

ARG NGINX_VERSION=1.31.5
ARG MODULE_REF=v0.9.2
ARG INSTALL_SHA256
FROM nginx:${NGINX_VERSION}-alpine

ARG MODULE_REF
ARG INSTALL_SHA256

# Install dependencies and install the module in one layer.
RUN test -n "${INSTALL_SHA256}" \
    && apk add --no-cache \
    bash \
    curl \
    gawk \
    gnupg \
    gzip \
    python3 \
    tar \
    && curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/cnkang/nginx-markdown-for-agents/releases/download/${MODULE_REF}/nginx-markdown-for-agents-installer-${MODULE_REF}.sh" \
        -o /tmp/install.sh \
    && echo "${INSTALL_SHA256}  /tmp/install.sh" | sha256sum -c - \
    && chmod +x /tmp/install.sh \
    && SKIP_ROOT_CHECK=1 /tmp/install.sh \
    && rm -f /tmp/install.sh \
    && grep -q '^user[[:space:]][[:space:]]*nginx;' /etc/nginx/nginx.conf \
    && sed -i '/^user[[:space:]][[:space:]]*nginx;/d' /etc/nginx/nginx.conf \
    && grep -q 'pid[[:space:]][[:space:]]*/var/run/nginx.pid;' /etc/nginx/nginx.conf \
    && sed -i 's#pid[[:space:]][[:space:]]*/var/run/nginx.pid;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && grep -q 'listen[[:space:]][[:space:]]*80;' /etc/nginx/conf.d/default.conf \
    && sed -i 's#listen[[:space:]][[:space:]]*80;#listen 8080;#' /etc/nginx/conf.d/default.conf \
    && grep -q 'listen[[:space:]][[:space:]]*\[::\]:80;' /etc/nginx/conf.d/default.conf \
    && sed -i 's#listen[[:space:]][[:space:]]*\[::\]:80;#listen [::]:8080;#' /etc/nginx/conf.d/default.conf \
    && printf '%s\n' \
        'client_body_temp_path /tmp/client_temp;' \
        'proxy_temp_path /tmp/proxy_temp;' \
        'fastcgi_temp_path /tmp/fastcgi_temp;' \
        'uwsgi_temp_path /tmp/uwsgi_temp;' \
        'scgi_temp_path /tmp/scgi_temp;' \
        > /etc/nginx/conf.d/00-nonroot-runtime.conf

# OR: If you need a specific version
# ARG MODULE_REF=v0.9.2

# OR: For local development/testing, copy only the install script
# COPY tools/install.sh /tmp/install.sh
# RUN SKIP_ROOT_CHECK=1 bash /tmp/install.sh && rm /tmp/install.sh

USER nginx

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
