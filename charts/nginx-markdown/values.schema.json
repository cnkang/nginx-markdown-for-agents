{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cnkang/nginx-markdown-for-agents/charts/nginx-markdown/values.schema.json",
  "title": "nginx-markdown Helm values",
  "type": "object",
  "properties": {
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "onError": { "type": "string" },
        "flavor": {
          "type": "string",
          "enum": ["commonmark", "gfm"],
          "description": "Markdown dialect; see the markdown_flavor directive values."
        },
        "tokenEstimate": { "type": "boolean" },
        "conditionalRequests": {
          "type": "string",
          "enum": ["off", "ims_only", "full"],
          "description": "Cache validation mode; see the markdown_cache_validation directive values."
        },
        "logVerbosity": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug"],
          "description": "Decision log verbosity; see the markdown_log_verbosity directive values."
        },
        "autoDecompress": {
          "type": "boolean",
          "description": "Must be a real boolean. String overrides such as \"on\" are rejected during values validation instead of being coerced in the configmap template."
        },
        "loadModule": { "type": "string" },
        "streaming": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["off", "auto", "force"],
              "description": "Processing-path policy; see the markdown_streaming directive values."
            }
          }
        },
        "prune": {
          "type": "object",
          "properties": {
            "noise": { "type": "boolean" },
            "selectors": { "type": "string" },
            "protectionSelectors": { "type": "string" }
          }
        },
        "contentTypes": { "type": "array", "items": { "type": "string" } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conversionMemory": { "type": "string" },
            "conversionTimeout": { "type": "string" },
            "parserMemory": { "type": "string" },
            "parserTimeout": { "type": "string" },
            "streamingBuffer": { "type": "string" },
            "decompressedSize": { "type": "string" },
            "decompressionRatio": { "type": "integer", "minimum": 1 },
            "maxInflight": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-fA-F]{64}$",
          "description": "Immutable image digest; takes precedence over tag."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "uri": { "type": "string" },
        "shmSize": { "type": "string" },
        "sidecar": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Image repository; required by the Deployment when the sidecar is enabled."
                },
                "tag": { "type": "string" },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[0-9a-fA-F]{64}$",
                  "description": "Immutable image digest; preferred over tag when the sidecar is enabled."
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": ["Always", "IfNotPresent", "Never"]
                }
              },
              "additionalProperties": false
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "not": { "const": 8080 },
              "description": "Sidecar port; 8080 is reserved for the module HTTP listener."
            },
            "resources": {
              "type": "object",
              "description": "Kubernetes container resource requests and limits.",
              "properties": {
                "limits": { "type": "object" },
                "requests": { "type": "object" }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
